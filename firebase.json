{
  "hosting": [
    {
      "target": "sbx-site",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {"source": "/service-worker.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://www.linkedin.com/in/alecng",
          "type": 301
        },
        {
          "source": "/index.html",
          "destination": "https://www.linkedin.com/in/alecng",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "site",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {"source": "/service-worker.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://www.linkedin.com/in/alecng",
          "type": 301
        },
        {
          "source": "/index.html",
          "destination": "https://www.linkedin.com/in/alecng",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
